{
  "name": "hello-yb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel data:watch image:watch colors:watch dev:next",
    "dev:next": "next dev --turbopack",
    "build": "npm-run-all data:build generate-images generate-party-colors next:build",
    "next:build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "data:build": "tsx scripts/process-data.ts",
    "data:watch": "tsx scripts/process-data.ts --watch",
    "generate-images": "tsx scripts/generate-image-map.ts",
    "image:watch": "tsx scripts/generate-image-map.ts --watch",
    "generate-party-colors": "tsx scripts/generate-party-colors.ts",
    "colors:watch": "tsx scripts/generate-party-colors.ts --watch"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "chokidar": "^4.0.3",
    "csv-parse": "^6.1.0",
    "fs-extra": "^11.3.2",
    "get-image-colors": "^4.0.1",
    "lucide-react": "^0.553.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/fs-extra": "^11.0.4",
    "@types/get-image-colors": "^4.0.5",
    "@types/node": "^20.19.25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
